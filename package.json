{
  "name": "barix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Barix: a custom AI runtime (context, memory, coding, tools, verification, routing) around an open-weight foundation model.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "node --test packages/core/test/*.test.js apps/term/test/*.test.js",
    "build:web": "node scripts/build-web.mjs",
    "bench": "node scripts/bench.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0"
  },
  "dependencies": {
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "web-tree-sitter": "^0.27.0"
  }
}
