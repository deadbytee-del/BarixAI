{
  "name": "barix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Barix: a custom AI runtime (context, memory, coding, tools, verification, routing) around an open-weight foundation model.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "node --test packages/core/test/*.test.js apps/term/test/*.test.js",
    "test:browser": "node --test apps/web/test/web.test.js apps/web/test/p2p.test.js",
    "test:real": "BARIX_REAL=1 node --test packages/core/test/*.test.js apps/term/test/*.test.js",
    "build:web": "node scripts/build-web.mjs",
    "serve": "node scripts/serve.mjs --base /BarixAI/ --dir apps/web/dist",
    "bench": "node scripts/bench.mjs",
    "bench:context": "node --expose-gc scripts/bench-context.mjs",
    "barixterm": "node apps/term/bin/barixterm.js",
    "start": "node scripts/build-web.mjs && node scripts/serve.mjs --base / --dir apps/web/dist --port 8080"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0"
  },
  "dependencies": {
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "web-tree-sitter": "^0.27.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/deadbytee-del/BarixAI"
  },
  "homepage": "https://deadbytee-del.github.io/BarixAI/"
}
